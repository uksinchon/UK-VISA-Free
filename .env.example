# ─────────────────────────────────────────
# SEO / Analytics 환경변수
# 실제 운영 환경에 맞춰 값을 채워 .env.local 또는 Netlify Site settings에 등록하세요.
# ─────────────────────────────────────────

# Google Analytics 4 측정 ID
# https://analytics.google.com → 관리 → 데이터 스트림에서 확인 (예: G-ABCD123456)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console 사이트 소유권 인증 코드 (메타 태그 방식)
# https://search.google.com/search-console → 속성 추가 → HTML 태그 → content 값
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# 네이버 웹마스터도구 사이트 소유권 인증 코드
# https://searchadvisor.naver.com → 사이트 등록 → HTML 태그 → content 값
NEXT_PUBLIC_NAVER_VERIFICATION=
